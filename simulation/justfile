# Auto Mode Eval — task runner. `just` lists recipes.

default:
    @just --list

# Install the pre-commit hooks (large-file guard, >512KB); run once after clone.
[group('dev')]
setup:
    uv run pre-commit install

# Lint + typecheck src (ruff then ty); pass a path to scope it, e.g. `just lint journal/...`.
[group('dev')]
lint path="src":
    uv run ruff check {{path}}
    uv run ty check {{path}}

# Liveness-check every model in the registry (real API calls). Pass -m <shorthand> to scope.
[group('dev')]
check-models *args:
    uv run python -m auto_mode_eval.model_utils {{args}}

# Run the large-file guard over the whole tree (pre-commit checks staged only).
[group('dev')]
check-large-files:
    uv run pre-commit run check-added-large-files --all-files

# Rebuild the paper's parquet tables from the blessed grid; run after blessing a run.
# `reuse=1` skips the capability logs (two minutes) and derives from the frozen grid — right
# after a rename, a relabel or a pooling change, wrong after a run lands.
[group('paper')]
tables-build reuse="0":
    uv run python -m auto_mode_eval.paper_results.analysis.tables \
      {{ if reuse == "0" { "" } else { "--reuse" } }}
